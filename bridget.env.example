# bridget configuration. Copy this to ~/.pogo/bridget.env and fill in values.
# Format: key=value (one per line, no quotes, no leading/trailing whitespace
# around the `=`). Lines starting with `#` and blank lines are ignored.
#
# Process environment variables with the same names override values here, so
# launchd / systemd unit files can inject overrides without editing this file.

# ─── Required ─────────────────────────────────────────────────────────────────

# Discord bot token. Create a bot at https://discord.com/developers/applications,
# enable the "Message Content" privileged intent, and paste the token here.
DISCORD_BOT_TOKEN=

# Your Discord user ID (snowflake — an integer, e.g. 123456789012345678).
# Enable Developer Mode in Discord, right-click your name → Copy User ID.
# bridget will only respond to DMs from this user.
DISCORD_USER_ID=

# The Discord server (guild) the bot is installed in. Right-click the server
# icon in Developer Mode → Copy Server ID.
DISCORD_SERVER_ID=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Absolute path to the `mg` binary. If unset, bridget resolves it via PATH
# (`shutil.which("mg")`). Set this only if `mg` is installed somewhere your
# shell PATH doesn't reach when bridget runs (e.g. under launchd).
#MG_BIN=/usr/local/bin/mg

# Absolute path to the `pogo` binary. If unset, bridget resolves it via PATH
# (`shutil.which("pogo")`). Set this only if `pogo` is installed somewhere your
# shell PATH doesn't reach when bridget runs (e.g. under launchd).
#POGO_BIN=/usr/local/bin/pogo

# Parent directory of `new/` and `cur/` mail subdirs. Default:
# ~/.macguffin/mail/human (the canonical pogo mail location). Override if your
# pogo install puts mail elsewhere.
#
# If you run a REPRESENTATIVE (see POGO_REPRESENTATIVE below), point this at the
# representative's OUTPUT box, not at `human`: `human` becomes the
# representative's inbox, and bridget moves what it reads from new/ to cur/ —
# which would silently satisfy the deadman that exists to catch mail nobody
# processed. This is where mail is DELIVERED from, and everything on the
# delivery path follows it — the DM watcher, `cur/`, and `read <mg-id>`.
#
# The approval SCAN does not; it has its own key, below.
#POGO_MAIL_DIR=~/.macguffin/mail/human

# Mailbox the approval SCAN reads — a bare name, resolved as a sibling of the
# delivery box under the same mail root. Default: `human`.
#
#   POGO_MAIL_DIR=~/.macguffin/mail/human   scan reads ~/.macguffin/mail/human/new
#   POGO_MAIL_DIR=~/.macguffin/mail/daniel  scan reads ~/.macguffin/mail/human/new
#   POGO_MAIL_DIR=~/mail2/human             scan reads ~/mail2/human/new
#
# So moving the whole mail root carries the scan along, while re-pointing the
# RECIPIENT does not. That asymmetry is the point (mg-18bf). Putting a
# representative in front of the fleet re-points POGO_MAIL_DIR at its output
# box — the DM watcher MUST move, or bridget DMs you every raw queue mail and
# bypasses the relay entirely. But the output box holds REWRITTEN subjects, and
# rewriting is the representative's job: nothing in it matches
# BRIDGET_APPROVAL_RE, so the "Awaiting your approval" section would have gone
# quiet and read exactly like an empty plate.
#
# Leaving the scan on `human` reintroduces no noise: it is a pull view that
# fires no notification and moves no file, so the deadman still sees whatever
# the representative has not processed.
#
# `status`, `mine`, `settings` and the startup log all name the box this
# resolves to, and say out loud when a scan read mail and matched none of it.
#BRIDGET_APPROVAL_MAILBOX=human

# The mailbox of a representative crew agent, if you run one. Empty (the
# default) means you do not, and bridget behaves exactly as it always has.
#
# A representative sits between the fleet and you: it owns `human` as its inbox,
# strips internal identifiers, makes agents supply the takeaway, coalesces a
# burst of nine mails about one incident into one, and writes a separate
# terminal box that the notifier polls (see POGO_MAIL_DIR).
#
# OUTBOUND mail routes through it. INBOUND — your Discord replies, which bridget
# relays to agents as `--from=human` — does NOT: those are your own words, and
# putting a rewriter in the middle of them would be worse than the problem the
# representative solves. Setting this key files a marked COPY of each relayed
# reply into the representative's own box, so it knows what you have already
# been told and already settled. Without that, it re-summarises answered
# questions and agents get replies referring to text it wrote rather than text
# they sent.
#
# The copy is best-effort: a failure is logged and ignored, never turned into a
# failed reply.
#POGO_REPRESENTATIVE=representative

# Directory containing `mg-XXXX.md` design docs, used by the `next mg-XXXX`
# command. Default: ~/.pogo/designs (auto-created by your design-writing
# workflow if you use one). Set this only if your design docs live elsewhere.
#POGO_DESIGNS_DIR=~/Pogo/designs

# Repo (or directory used as one) where new items filed via `idea:`, `bug:`,
# and `next` should be created. Default: ~/.pogo/inbox. Set this only if you
# want new items routed to a specific tracked repo.
#POGO_INBOX_REPO=~/Pogo

# Default recipient agent for the `mail <subject>` Discord command. Default:
# `mayor`. Override if your install routes mail to a differently-named
# coordinator agent.
#POGO_MAIL_RECIPIENT=mayor

# Optional override for the bridget git checkout directory. By default,
# bridget self-detects this from its own script location (works when
# ~/.pogo/bin/bridget is symlinked into the repo, which is what install.sh
# does). Set this only if you run bridget from an unusual setup.
#BRIDGET_REPO_DIR=/Users/yourname/DUGLocal/bridget

# Optional override for the virtualenv holding discord.py. bridget's shebang
# resolves to the system python3, which usually has no discord.py; when the
# import is unavailable bridget re-execs itself into this venv's interpreter.
# Default: ~/.pogo/venv-bridget, which is what install.sh builds. Set this only
# if you manage the venv yourself (e.g. you ran install.sh --no-venv).
#BRIDGET_VENV_DIR=/Users/yourname/.pogo/venv-bridget

# ─── Threading & the calm inbox (all optional; unset = v1.x behavior) ─────────

# Discord channel (snowflake) where conversation threads are rooted.
#
# Discord threads can only exist inside a guild TEXT channel — a DM channel
# cannot host one. So bridget puts the firehose in this channel and roots one
# thread per conversation there, leaving your DMs as a calm, curated inbox.
# Replying inside a thread mails your reply back to whoever started it.
#
# Unset (the default) = threading off, behavior identical to bridget v1.x.
# The bot needs View Channel / Send Messages / Create Public Threads /
# Send Messages in Threads on this channel.
#BRIDGET_LOG_CHANNEL_ID=123456789012345678

# How much mail reaches your DMs. Requires BRIDGET_LOG_CHANNEL_ID unless `all`,
# because otherwise suppressed mail would have nowhere to go (bridget refuses
# to start rather than silently drop your notifications).
#
#   all      every mail DMs you. The default; what bridget always did.
#   curated  only mail that wants a decision (see BRIDGET_APPROVAL_RE) DMs you.
#            Everything else lands in the log channel. The calm inbox.
#   none     nothing DMs you; the log channel is the only surface.
#
# Changeable at runtime with the `dm <policy>` command — this key is only the
# starting value, and ~/.pogo/bridget.settings.json holds the live state.
#BRIDGET_DM_POLICY=all

# Whether to thread replies using `mg mail send --in-reply-to` (macguffin
# gh#66). Replies always deliver; without this they simply arrive as new
# top-level mail instead of joining the conversation.
#
#   auto  probe `mg mail send --help` once and use the flag if present. Default.
#   on    assume mg supports it (skip the probe).
#   off   never pass it.
#
# `auto` is right for almost everyone: it copes with an mg that predates gh#66,
# and with an mg swapped underneath a running bridget by an unrelated
# `go install` — a send rejected for the flag downgrades and retries once.
#BRIDGET_CORRELATION_IDS=auto

# ─── Behavioural knobs (defaults preserve v1.0.0 behavior) ────────────────────

# Recipient/assignee for the workflow verbs (approve / reject / revise /
# explain / next mg-XXXX) and filing commands (idea: / bug:). Default:
# `architect`. Override if your install routes design coordination through a
# different agent (e.g. a per-PM agent or a coordinator).
#POGO_WORKFLOW_AGENT=architect

# Base tag stamped on items filed via `idea:`, `bug:`, and `next`. Inline
# `[scope]` tags from the user are still appended on top. Default:
# `pogo-inbox`. Override if your install uses a different inbox-tag
# convention.
#POGO_INBOX_TAG=pogo-inbox

# Polling interval in seconds for the mailbox / task-transitions / idea-claims
# watchers. Default: `5`. Lower = snappier notifications + more `mg list`
# work; higher = quieter on flaky networks or shared dev hosts.
#BRIDGET_POLL_INTERVAL=5

# How often (seconds) the task-transition watcher runs its full `mg list --all`
# diff. Default: `60`. The hot poll runs every BRIDGET_POLL_INTERVAL with a
# cheap non---all `mg list` (which walks ~14 live records); only this slower
# full diff pays for --all's ~3000+ archive-tombstone walk, the I/O that fed the
# mg-list-timeout storm (mg-e5b8/mg-4fc0). The full diff is what announces
# shelved/archived transitions the hot poll can't see, so this is also the
# worst-case latency for a `📦 shelved` notification. Must be >=
# BRIDGET_POLL_INTERVAL. Lower = snappier shelved notices + more --all work;
# higher = fewer tombstone walks.
#BRIDGET_FULL_POLL_INTERVAL=60

# ─── The duplication limit (mg-5521) ─────────────────────────────────────────
#
# Fleet watchers repeat themselves. A measured snapshot of one maildir held 1404
# unread, in which a single alert appeared 31 times and the three loudest rows
# were ONE condition whose fire count drifted (90 / 91 / 92 fires). bridget is
# the chokepoint every sender crosses on the way to Discord, so the limit lives
# here rather than in any one watcher.
#
# A condition is (sender, subject-with-digits-folded-to-N). mg-ids are NOT
# folded: two approvals for two different ids are two decisions, not a repeat.
#
# The FIRST firing of a condition is always delivered, immediately. Repeats are
# held, counted, and reported: the next notice says "still happening — notice
# #N, M repeats suppressed since T", every suppression gets a `dedup:` line in
# the log, and `dupes` in Discord shows the standing tally. Nothing is deleted —
# bridget is observe-only, so every copy is still in `human/new/`.
#
# Seconds to wait after a notice before the same condition may notify again.
# Each further notice DOUBLES the wait, up to BRIDGET_DEDUP_MAX_WINDOW, so a
# condition that keeps firing keeps saying so at a decaying rate rather than
# going silent. Default: `900` (15 minutes). Set to `0` to switch the limit off
# entirely and deliver every repeat, as bridget did before v1.5.
#BRIDGET_DEDUP_WINDOW=900

# Ceiling on that doubling, in seconds. Default: `14400` (4 hours) — a condition
# firing all day still checks in six times, which is the difference between
# "quieter" and "gone". Must be >= BRIDGET_DEDUP_WINDOW.
#BRIDGET_DEDUP_MAX_WINDOW=14400

# How long a condition must go unseen before its next firing counts as NEW —
# delivered immediately, with the backoff reset. Default: `86400` (24 hours).
# Must be >= BRIDGET_DEDUP_WINDOW, or every firing would look like a first
# occurrence and the limit would quietly do nothing.
#BRIDGET_DEDUP_TTL=86400

# ---------------------------------------------------------------------------
# The delivery path's positive record (mg-7c1b)
# ---------------------------------------------------------------------------
# Seconds between `relay: N delivered in the last Ts (M total since ...)` lines
# in ~/.pogo/bridget.log. Default: `3600` — 24 lines a day on a bridget with
# nothing to carry.
#
# The line exists because bridget used to log delivery ONLY when it went wrong,
# and a log that records only exceptions cannot be used to confirm the normal
# path ran: its silence is consistent with perfect health AND with total death.
# Two agents read `grep -c` returning 0 against this file on the same night; one
# of them concluded "Discord carried NONE" while bridget had in fact relayed all
# 33 alarms within seconds.
#
# So the beat fires even with NOTHING to report — that is the half that makes
# silence mean death, and the half a per-mail line cannot do. It fires sooner
# (at most once a minute) on a cycle that actually delivered, folding a burst
# into one line with a count rather than one line per mail. And it fires ONLY on
# a cycle that reached Discord without a send failure: a beat that ticked
# through a wedge would read as a positive across an outage, which is how
# bridget.heartbeat missed a 70-hour one (mg-e5b8).
#
# Set to `0` to switch the record off. That restores the pre-v1.7 file — the one
# whose zero means nothing.
#BRIDGET_RELAY_HEARTBEAT=3600

# When a delivery outage stops being bridget's problem (mg-3f08).
#
# The record above makes an outage legible to someone reading bridget.log. On
# 2026-08-19 nobody was: delivery failed 100% for eight minutes — the same DNS
# failure on discord.com:443 that had already happened three times that
# fortnight, once for 71.6 hours — while the host resolved discord.com 5/5 from
# a shell. No alert, no mail, no event, no change in any health surface. The
# message stuck in the retry loop was pogod's own "AGENTS ARE FAILING EVERY
# TURN" escalation to the human, so the fleet-health alarm and the only
# transport it has failed together.
#
# ESCALATE — seconds of unbroken delivery failure before the outage is reported
# OUT OF BAND: a `pogo events` record and a mail to the mayor's maildir, both
# local files. Never over Discord — reporting a broken transport through itself
# is the circularity this exists to break. `0` switches it off and restores the
# state above; a self-heal still forces one out, because a silent restart is the
# same defect wearing the fix's clothes.
#BRIDGET_WEDGE_ESCALATE_AFTER=120

# SELF-HEAL — seconds before bridget exits 75 and lets bridget-supervise respawn
# it. Cheap, and the only remedy with a measured success rate: all four
# occurrences ended in a restart and none ended any other way, the supervisor
# comes back in 5s, and a mail is committed to bridget.seen only once it has
# actually landed, so nothing behind the wedge is lost. `0` switches it off.
#BRIDGET_WEDGE_SELFHEAL_AFTER=300

# REPEAT — how often a still-unresolved outage re-escalates, so the 71.6h one is
# not a single mail three days stale.
#BRIDGET_WEDGE_REPEAT=3600

# BUDGET — self-heals allowed per window, counted in ~/.pogo/bridget.selfheal.json
# because an in-memory cap on restarts is reset BY the restart, which is a flap
# wearing a rate limiter's clothes. A genuine network outage costs three respawns
# and then stops, leaving a live bridget escalating rather than a flapping one.
# A restart that cannot be recorded is REFUSED — a budget that fails open is not
# a budget. `0` switches the self-heal off.
#BRIDGET_WEDGE_RESTART_BUDGET=3
#BRIDGET_WEDGE_BUDGET_WINDOW=3600

# When `true`, the outbound watchers consult ~/.pogo/quiet.json and suppress
# DMs while quiet hours are active (state still updates internally — only the
# user-facing send is gated). Inbound DMs from the user are always processed,
# since typing during quiet hours is consenting. Default: `false` (no change
# from v1.0.0). Most Daniel-shaped installs probably want `true`.
#BRIDGET_QUIET_RESPECTS_OUTBOUND=false

# Regex matched against the first `Subject:` header of an unread mail to flag
# it as an approval request in `status`. Default: `^Subject: approval needed `
# (literal v1.0.0 prefix). Override if your pogo install uses a different
# approval-mail subject convention.
#BRIDGET_APPROVAL_RE=^Subject: approval needed

# Shell command to validate the new bridget checkout before respawning, run
# from BRIDGET_REPO_DIR. Default: `bash build.sh`. Override on hosts without
# bash, or if you've renamed the build script (e.g. `make check`).
#BRIDGET_RESTART_CMD=bash build.sh

# Regex matched against `assignee` to decide whether `claimed by …`
# annotation should be added to a task-transition message. Anything that
# matches the pattern is treated as a *crew agent* (annotation suppressed);
# anything that does not match is a polecat (`by polecat-foo` is appended).
# Default: `^(architect|mayor|human|pm-.*|)$` — widens the v1.0.0 literal
# `{architect, mayor, human, ''}` set to also absorb any `pm-*` agent.
# Override if your install names crew agents differently
# (e.g. `^(coordinator-.*|lead-.*|architect|)$`).
#BRIDGET_CREW_PATTERN=^(architect|mayor|human|pm-.*|)$
